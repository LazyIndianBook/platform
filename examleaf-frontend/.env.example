# examleaf-frontend: copy to .env.local for development (README.md, "Local setup").
# NEXT_PUBLIC_* values are compiled into the build: set them before `npm run build` (Docker: build arguments).

# The public address, no trailing slash: canonical URLs, Open Graph, the sitemap, the Host Django sees.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Django for server-side calls (compose: http://web:8000). In development the frontend also proxies Django's
# paths (/api/, /_allauth/, /static/ …) to it, so the browser stays on one origin.
API_INTERNAL_BASE=http://localhost:8100
# The browser calls the API on its own origin; leave empty unless the API lives elsewhere.
NEXT_PUBLIC_API_BASE=
# Allowed by the CSP only where needed: Razorpay on /checkout/* (8B), Turnstile when its site key is set, the
# public media host (no https://) for product pictures.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_MEDIA_HOST=
