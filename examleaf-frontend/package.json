    "input-otp": "^1.5.0",
    "katex": "^0.19.0",
    "lean-qr": "^2.7.4",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
