# TLS termination and reverse proxy. With DOMAIN=examleaf.in Caddy gets and renews a Let's Encrypt certificate by
# itself (ports 80 and 443 must reach this machine); with DOMAIN=localhost it uses its own local certificate.
{$DOMAIN} {
	encode zstd gzip
	# One ID per request, in Caddy's access log and in every Django log line for the request (django-guid).
	request_header X-Request-ID {http.request.uuid}
	# Clip videos for the revision course are uploaded through the admin (LEARN_MAX_UPLOAD_MB, default 500); every other
	# request body stays at 10 MB. gunicorn's worker timeout is raised to match (GUNICORN_CMD_ARGS in docker-compose.yml).
	@clip_upload path /admin/learn/clip/* /admin/learn/revision/*
	request_body @clip_upload {
		max_size 500MB
	}
	@other not path /admin/learn/clip/* /admin/learn/revision/*
	request_body @other {
		max_size 10MB
	}
	header -Server
	# /health/ and /health/web/ answer only the uptime monitor, which sends the header X-Health-Token with the value of
	# HEALTH_CHECK_TOKEN (.env; letters, digits, - and _). Everyone else gets 404, and nobody while it is unset. The
	# web container's own health check calls 127.0.0.1:8000 directly, not through Caddy.
	@health_denied {
		path /health /health/*
		not expression `"{$HEALTH_CHECK_TOKEN}" != "" && {http.request.header.X-Health-Token} == "{$HEALTH_CHECK_TOKEN}"`
	}
	respond @health_denied 404
	reverse_proxy web:8000
	log {
		output stdout
		format json
	}
}
