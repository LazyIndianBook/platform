# TLS termination and reverse proxy. With DOMAIN=examleaf.in Caddy gets and renews a Let's Encrypt certificate by
# itself (ports 80 and 443 must reach this machine); with DOMAIN=localhost it uses its own local certificate.
{
	servers {
		# A client has 10 seconds for its request's headers and 5 minutes for its body (a photo from a slow phone):
		# what it sends slowly waits here, in Caddy, not in gunicorn (request_buffers below).
		timeouts {
			read_header 10s
			read_body 5m
		}
	}
}

{$DOMAIN} {
	encode zstd gzip
	# One ID per request, in Caddy's access log and in every Django log line for the request (django-guid).
	request_header X-Request-ID {http.request.uuid}
	# Every request body stays at 10 MB, except on the clip and revision admin pages: 500 MB there is the development
	# fallback for clip videos (no bucket: the file comes with the form, LEARN_MAX_UPLOAD_MB). In production the editor's
	# browser sends the video straight to the bucket (learn/uploads.py) and the form carries only its name (H1); Django
	# refuses a body that large from anyone but signed-in staff (learn.uploads.LargeBodyGuard).
	@clip_upload path /admin/learn/clip/* /admin/learn/revision/*
	request_body @clip_upload {
		max_size 500MB
	}
	@other not path /admin/learn/clip/* /admin/learn/revision/*
	request_body @other {
		max_size 10MB
	}
	header -Server
	# /health/ and /health/web/ answer only the uptime monitor, which sends the header X-Health-Token with the value of
	# HEALTH_CHECK_TOKEN (.env; letters, digits, - and _). Everyone else gets 404, and nobody while it is unset. The
	# web container's own health check calls 127.0.0.1:8000 directly, not through Caddy.
	@health_denied {
		path /health /health/*
		not expression `"{$HEALTH_CHECK_TOKEN}" != "" && {http.request.header.X-Health-Token} == "{$HEALTH_CHECK_TOKEN}"`
	}
	respond @health_denied 404
	# Phase 8 (docs/examleaf-phase8-nextjs-plan.md): Django's own paths go to web; every other path is a page of the
	# website, the Next.js frontend's (examleaf-frontend/): PAGES_UPSTREAM, frontend:3000 by default. Django serves no
	# page of its own any more. Both sit on one origin, so the session and CSRF cookies are shared.
	@django path /api/* /_allauth/* /admin/* /shop/webhooks/* /anymail/* /health /health/* /shop/media/* /learn/preview/* /learn/hls/* /account/google/* /qr/* /static/*
	reverse_proxy @django web:8000 {
		# The whole body (up to 10 MB) is read here before gunicorn sees the request: a client that sends it slowly
		# holds a Caddy connection, never one of gunicorn's threads (H1).
		request_buffers 10MB
	}
	reverse_proxy {$PAGES_UPSTREAM:frontend:3000} {
		request_buffers 10MB
	}
	log {
		output stdout
		format json
	}
}

# The staff console (examleaf-admin/, the compose profile "admin"): its own host, so a script on the public site can
# never ride a staff session, and the cookies stay host-only (no cookie domain is shared). The same Django paths, limits,
# health rule and logging as above (keep the two blocks in step); every other path is the console's. Caddy asks for this
# host's certificate too: point its DNS at the machine before starting. Django must list the host in ALLOWED_HOSTS and
# its origin in CSRF_TRUSTED_ORIGINS (examleaf-admin/README.md, "Deploy").
admin.{$DOMAIN} {
	encode zstd gzip
	request_header X-Request-ID {http.request.uuid}
	# Next.js's internal subrequest header is never a visitor's to send (CVE-2025-29927): dropped before it reaches the
	# console, which never relies on its proxy for access anyway
	request_header -X-Middleware-Subrequest
	@clip_upload path /admin/learn/clip/* /admin/learn/revision/*
	request_body @clip_upload {
		max_size 500MB
	}
	@other not path /admin/learn/clip/* /admin/learn/revision/*
	request_body @other {
		max_size 10MB
	}
	header -Server
	@health_denied {
		path /health /health/*
		not expression `"{$HEALTH_CHECK_TOKEN}" != "" && {http.request.header.X-Health-Token} == "{$HEALTH_CHECK_TOKEN}"`
	}
	respond @health_denied 404
	@django path /api/* /_allauth/* /admin/* /shop/webhooks/* /anymail/* /health /health/* /shop/media/* /learn/preview/* /learn/hls/* /account/google/* /qr/* /static/*
	reverse_proxy @django web:8000 {
		request_buffers 10MB
	}
	reverse_proxy admin:3000 {
		request_buffers 10MB
	}
	log {
		output stdout
		format json
	}
}
