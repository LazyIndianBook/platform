# ExamLeaf settings. Copy to .env: `manage.py` and `docker compose` both read it. In production keep .env readable by
# the deploying user only (chmod 600): it holds the secrets. Lines starting with # are examples or defaults.

# --- Core -----------------------------------------------------------------------------------------------------------
# 1 in development only. With 0: https redirect, secure cookies, one-year HSTS, static files from the collected set.
DEBUG=1
# Long and random in production: python3 -c "import secrets; print(secrets.token_urlsafe(50))". Changing it logs
# everybody out and changes the consent address hashes (RUNBOOK.md, rotating secrets).
SECRET_KEY=dev-only-change-me
# (With DEBUG=0 the site refuses to start with a key that starts with dev- or is shorter than 50 characters; with
# DEBUG=1 it refuses ALLOWED_HOSTS other than localhost, 127.0.0.1 and [::1].)
# While rotating: the previous key(s), comma separated, so that sessions and reset links keep working.
# SECRET_KEY_FALLBACKS=
# Host names the site answers to (comma separated).
ALLOWED_HOSTS=localhost,127.0.0.1
# Base URL printed inside the QR codes and used in emails (no trailing slash). https in production.
SITE_URL=http://localhost:8000
# Origins trusted for form posts; defaults to SITE_URL. Add others only if the site is served under several names.
# CSRF_TRUSTED_ORIGINS=https://examleaf.in,https://www.examleaf.in
# A checkout of the books repository LazyIndianBook/Class-12-Assam (it holds production/), for import_papers and
# import_chapter_insights. Default: "Class 12" beside this repository, when it is there; compose sets /book.
# PAPERS_ROOT=/srv/books
# Who reads the solutions behind the QR codes (website and API): 1 = signed-in students only (the default), 0 = everyone
# (accounts only for saving marks, orders and the app). README.md "Open or registered solutions" weighs the two.
# SOLUTIONS_REQUIRE_LOGIN=1
# A parent's consent for a student under 18: declared (the parent ticks the sign-up box) or verified (the parent also
# confirms through a link emailed, or with SMS on texted, to them; until then the account cannot save marks or order).
# Switch to verified before May 2027, when the DPDP Rules ask for verifiable consent (DEPLOYMENT.md section 14).
# PARENTAL_CONSENT_MODE=declared
# Largest form or JSON body accepted, in bytes (files not counted); the API answers 413 above it. Caddy stops 10 MB.
# DATA_UPLOAD_MAX_MEMORY_SIZE=1048576

# --- Database and cache ---------------------------------------------------------------------------------------------
# Default: the SQLite file db.sqlite3. Production: postgres://user:password@host:5432/examleaf (docker-compose.yml sets
# it for its own PostgreSQL from POSTGRES_PASSWORD).
# DATABASE_URL=postgres://examleaf:password@localhost:5432/examleaf
# Seconds a database connection is kept between requests (0 = close after each request). Persistent connections, no
# pool: each gunicorn worker serves one request at a time.
# CONN_MAX_AGE=60
# Shared cache (rate limits, throttles, cached pages) when running several processes; default is a per-process memory
# cache. With Redis down the site runs on without it (each call gives up within a second and counts as a miss); the
# shop's order lookup, checkout and coupon codes refuse meanwhile. In production a Redis of its own with a memory cap
# that evicts (docker-compose.yml: redis-cache, 256 MB, allkeys-lru), never Celery's queue, which must not evict.
# CACHE_URL=redis://localhost:6379/1

# --- Background tasks (Celery) --------------------------------------------------------------------------------------
# Without a broker, tasks (emails, the daily purge) run inline in the web process; tests always do.
# CELERY_BROKER_URL=redis://localhost:6379/0
# Force inline tasks even with a broker (1) or never (0).
# CELERY_TASK_ALWAYS_EAGER=0

# --- Email ----------------------------------------------------------------------------------------------------------
# Console (printed in the runserver window) in development. Production, through django-anymail, e.g. Brevo:
# EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
# ANYMAIL_BREVO_API_KEY=xkeysib-...
# DEFAULT_FROM_EMAIL=ExamLeaf <noreply@examleaf.in>
# Amazon SES in Mumbai, the production pick (DEPLOYMENT.md section 15), with keys of its own (not the S3 ones):
# EMAIL_BACKEND=anymail.backends.amazon_ses.EmailBackend
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_REGION=ap-south-1
# ANYMAIL_AMAZON_SES_CONFIGURATION_SET_NAME=examleaf
# Bounce and complaint webhooks (/anymail/<esp>/tracking/), user:password given to the provider in the URL; empty: no
# webhook URLs at all (Anymail would accept events from anyone).
# ANYMAIL_WEBHOOK_SECRET=

# --- Sign-in and SMS (DEPLOYMENT.md sections 15 and 16) ---------------------------------------------------------------
# console prints SMS (development); msg91 sends them. On a server, console means no phone log-in and no SMS at all.
# SMS_BACKEND=console
# At most this many SMS a day (India time), counted in the database.
# SMS_DAILY_CAP=500
# MSG91_AUTHKEY=
# MSG91's ids of the DLT templates (texts in RUNBOOK.md "SMS").
# MSG91_TEMPLATE_OTP=
# MSG91_TEMPLATE_ORDER_PLACED=
# MSG91_TEMPLATE_ORDER_SHIPPED=
# MSG91_TEMPLATE_ORDER_DELIVERED=
# MSG91_TEMPLATE_PARENT_CONSENT=
# Google sign-in, offered only when both are set (redirect URI: <SITE_URL>/account/google/login/callback/).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Cloudflare Turnstile on sign-up and code requests, on only when both are set.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Reverse proxy and https ----------------------------------------------------------------------------------------
# Number of proxies in front of the app; 1 trusts X-Forwarded-Proto/-For from it (docker-compose.yml sets 1 for Caddy).
# PROXY_COUNT=1
# Take the host name from X-Forwarded-Host (only if the proxy rewrites the Host header; Caddy does not).
# USE_X_FORWARDED_HOST=0
# The secret the Next.js frontend sends with its server-side calls (X-Internal-Token): only with it does Django count
# the visitor's address the frontend forwards instead of the frontend's own. The same value goes to the frontend
# (docker-compose.yml). Make one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# INTERNAL_API_TOKEN=
# With DEBUG=0 the https redirect and a one-year HSTS are on; set these only to change them.
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# SECURE_HSTS_PRELOAD=0

# --- Files: two S3-compatible buckets (Cloudflare R2; DEPLOYMENT.md sections 15 and 17) ----------------------------
# Unset: everything stays in the media/ folder (the public files are served under /shop/media/). Set all or none.
# MEDIA_BUCKET: private (invoices, credit notes, quotations, answer sheets; links signed for 5 minutes).
# PUBLIC_MEDIA_BUCKET: product pictures and Open Graph images, served from PUBLIC_MEDIA_DOMAIN (no https://).
# MEDIA_BUCKET=examleaf-private
# PUBLIC_MEDIA_BUCKET=examleaf-public
# PUBLIC_MEDIA_DOMAIN=media.examleaf.in
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# Private bucket on AWS S3 Mumbai (S3_REGION=ap-south-1, no S3_ENDPOINT_URL), public one on R2: its own settings.
# PUBLIC_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# PUBLIC_S3_REGION=auto
# PUBLIC_S3_ACCESS_KEY_ID=...
# PUBLIC_S3_SECRET_ACCESS_KEY=...
# boto3 with R2 (docker-compose.yml sets both; keep them when running outside Docker):
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# --- Backups (keys: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY) --------------------------------------------------------
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# Private bucket that scripts/backup.sh uploads the database dumps to (default: local backups/ folder only).
# BACKUP_BUCKET=examleaf-backups
# BACKUP_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# Days of local dumps that scripts/backup.sh keeps (match the Privacy Policy).
# BACKUP_KEEP_DAYS=30
# An age public key (age-keygen; keep the private key off the server): scripts/backup.sh uploads the dumps encrypted.
# BACKUP_AGE_RECIPIENT=age1...
# The X-Health-Token header the uptime monitor sends; Caddy answers /health/ with 404 to everyone else (letters,
# digits, - and _): python3 -c "import secrets; print(secrets.token_urlsafe(32))". Required: docker compose refuses to
# start the proxy while it is empty.
HEALTH_CHECK_TOKEN=

# --- Errors and logs ------------------------------------------------------------------------------------------------
# Sentry error reports (server side only, no personal data: examleaf/sentry.py scrubs each event). Empty = off.
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
# Version label for Sentry, e.g. the git commit.
# RELEASE=
# Log lines as JSON (default when DEBUG=0) or text; and the level.
# LOG_JSON=1
# LOG_LEVEL=INFO

# --- REST API (/api/v1/, API.md) ------------------------------------------------------------------------------------
# Web origins allowed to call the API from a browser (CORS), comma separated. The mobile app and the site need none.
# CORS_ALLOWED_ORIGINS=https://app.examleaf.in
# Lifetime of the app's access token (minutes) and refresh token (days); every refresh gives a new refresh token.
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=30
# The API tokens' own signing key (default: SECRET_KEY). Changing it logs every app out, not the website.
# JWT_SIGNING_KEY=
# Requests allowed per client address (anonymous), per signed-in user, and per address or user for log-in, sign-up,
# codes, passwords, data export and deletion. Counted in the cache: set CACHE_URL (Redis) with several processes.
# API_THROTTLE_ANON=200/minute
# API_THROTTLE_USER=600/minute
# API_THROTTLE_AUTH=30/minute
# The shop: guests' order lookup per client address (also 10 an hour per email address and per order number),
# starting or confirming payments (calls to Razorpay), and coupon codes tried per user.
# API_THROTTLE_ORDER_LOOKUP=10/hour
# API_THROTTLE_PAYMENT=30/minute
# API_THROTTLE_COUPON=10/hour

# --- Shop (README.md "Shop", DEPLOYMENT.md "Shop: Razorpay") ----------------------------------------------------------
# Razorpay API keys (Dashboard, Account & Settings, API Keys). rzp_test_… keys take no real money: keep them until
# the going-live checklist is done, then swap in the rzp_live_… pair. Empty: the payment page says online payment
# is not set up (orders stay pending).
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# The secrets typed when creating the webhook (Dashboard, Webhooks) for https://<domain>/shop/webhooks/razorpay/ with
# the events payment.captured, payment.failed, order.paid, refund.processed and refund.failed. Test Mode and Live Mode
# each have their own webhook: give each its own random secret. The site checks the one of its keys' mode (test keys:
# RAZORPAY_WEBHOOK_SECRET_TEST), so a test-mode webhook is refused (400) once the live keys are in. Empty: refused.
# RAZORPAY_WEBHOOK_SECRET_TEST=...
# RAZORPAY_WEBHOOK_SECRET=...
# 0: only staff can use the cart, checkout and payment (website and API); everyone sees the books and prices with
# "Shop opens soon". For Razorpay's activation review, while the site still runs on test keys.
# SHOP_OPEN=1
# Offer cash on delivery at checkout (1) or not (0, the default): only to accounts with a confirmed email address, at
# most two orders on their way per account, each worth at most SHOP_COD_MAX_VALUE rupees (shipping included).
# SHOP_COD_ENABLED=0
# SHOP_COD_MAX_VALUE=1500
# Each morning the SALES role is emailed the books on sale with fewer copies than this.
# SHOP_LOW_STOCK=5
# The seller printed on invoices. GSTIN empty: "not registered". SELLER_STATE is the two-letter state code (AS):
# a buyer in the same state gets CGST + SGST columns, others IGST; SELLER_STATE_CODE is GST's number (Assam 18).
# SELLER_LEGAL_NAME=ExamLeaf LLP
# SELLER_ADDRESS=House 1, Example Road, Guwahati, Assam 781001
# SELLER_GSTIN=
# SELLER_STATE=AS
# SELLER_STATE_CODE=18
# SELLER_EMAIL=orders@examleaf.in
# SELLER_PHONE=+91 98640 00000
# Where the contact form's messages go (Reply-To: the sender) and the support email of /api/v1/config/; empty: SELLER_EMAIL.
# SUPPORT_EMAIL=help@examleaf.in

# --- docker compose only --------------------------------------------------------------------------------------------
# The domain Caddy serves and gets the certificate for (localhost for a local run).
# DOMAIN=examleaf.in
# Password of the compose PostgreSQL (random, long; letters and digits only, it goes into a URL).
# POSTGRES_PASSWORD=
# gunicorn worker processes (about 2 x CPU cores + 1).
# WEB_CONCURRENCY=3
# Compose only: the books checkout on the host (it holds production/), mounted read-only at /book for import_papers
# (DEPLOYMENT.md section 4). Default: "Class 12" beside this repository.
# BOOK_SOURCE=/srv/books

# --- Revision course (learn/, DEPLOYMENT.md "Revision course") -------------------------------------------------------
# Largest clip video the admin accepts, in MB. With a bucket the editor's browser sends it straight there; without one
# it comes through Caddy, which allows 500 MB on the clip pages (DEPLOYMENT.md section 18).
# LEARN_MAX_UPLOAD_MB=500
# 1: the processed clips go to the public bucket (PUBLIC_MEDIA_DOMAIN) with plain links, cached by the CDN; 0 (the
# default): the private storage, played through links signed for 10 minutes. Process the clips again after a change.
# LEARN_PUBLIC_VIDEO=0
# Free without a code: the first clip of every revision and the flash cards of each subject's first chapter.
# LEARN_FREE_PREVIEW=1
# Days a book code or a purchase opens the course for, from that day.
# LEARN_ACCESS_DAYS=365
# The app's pages on Google Play and the App Store, for /api/v1/config/ (app_links); empty: not out yet.
# APP_LINK_ANDROID=https://play.google.com/store/apps/details?id=…
# APP_LINK_IOS=https://apps.apple.com/in/app/…
# Key of the book codes' hashes (random, 50+ characters). Set it once, BEFORE the first print run, and never change
# it: codes printed under one key work only with it. Required with DEBUG=0 (migrate stops: check learn.E001).
# LEARN_CODE_SECRET=
# Firebase Cloud Messaging for the app's daily reminder: the JSON of a service account with the role "Firebase Cloud
# Messaging API Admin" only, on one line, or the path of a mounted file (DEPLOYMENT.md). Empty: no reminders are sent.
# FCM_SERVICE_ACCOUNT_JSON=
# Book codes tried per user and per client address (a classroom shares one), and quiz answers per user.
# API_THROTTLE_LEARN_REDEEM=5/hour
# API_THROTTLE_LEARN_REDEEM_ADDRESS=5/hour
# API_THROTTLE_LEARN_QUIZ=600/hour
