# Copy to .env for development. In production set these as real environment variables.
DEBUG=1
SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Base URL printed inside the QR codes (no trailing slash).
SITE_URL=http://localhost:8000
# Default: SQLite file db.sqlite3. Production example: postgres://user:pass@host:5432/examleaf
# DATABASE_URL=sqlite:///db.sqlite3
# Shared cache for rate limits when running several workers, e.g. redis://localhost:6379/1 or dbcache://cache_table
# CACHE_URL=locmemcache://
# Email: console in development. Production example (django-anymail, Brevo):
# EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
# ANYMAIL_BREVO_API_KEY=xkeysib-...
# DEFAULT_FROM_EMAIL=ExamLeaf <noreply@example.com>
# Number of reverse proxies in front of the app (sets X-Forwarded-For/Proto trust); 0 = none.
# PROXY_COUNT=1
# With DEBUG=0 the https redirect and a one-year HSTS are already on; set these only to change them
# (SECURE_SSL_REDIRECT=0 if your proxy redirects to https itself).
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# SECURE_HSTS_PRELOAD=0
# Answer-sheet uploads in a private S3-compatible bucket (needs: pip install boto3); default is local media/.
# MEDIA_BUCKET=examleaf-answer-sheets
# MEDIA_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
