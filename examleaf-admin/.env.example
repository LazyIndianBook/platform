# examleaf-admin: copy to .env.local for development (README.md, "Local setup").
# NEXT_PUBLIC_* values are compiled into the build: set them before `npm run build` (Docker: build arguments). None of
# them is a secret, and no secret may ever be given a NEXT_PUBLIC_ name.

# The console's own address, no trailing slash: the host Django sees (it must be in Django's ALLOWED_HOSTS and
# CSRF_TRUSTED_ORIGINS).
NEXT_PUBLIC_SITE_URL=http://localhost:3020
# The public website, where staff set up two-step sign-in and passkeys on their account page.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
# ERPNext's desk, for the business modules' links (Finance, Tax, Inventory, Purchases, CRM). Empty: no links.
NEXT_PUBLIC_ERP_URL=
# Where the browser's /_allauth/ calls go. Empty (the default, and the only value the image has): the console's own
# origin, to which the proxy brings Django's paths.
# NEXT_PUBLIC_API_BASE=
# Django for server-side calls (compose: http://web:8000). In development the console also proxies Django's paths
# (/api/, /_allauth/, /static/, /admin/ …) to it, so the browser stays on one origin.
API_INTERNAL_BASE=http://localhost:8103
# The secret shared with Django (its INTERNAL_API_TOKEN), sent with every server-side call so that Django counts the
# person's address, not this server's.
INTERNAL_API_TOKEN=
# Development and tests only: 1 answers the staff API from the fixtures of src/mocks/staff/ (next dev only; every
# build compiles it out). Signing in still needs Django.
STAFF_API_MOCK=
